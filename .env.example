# Copy to apps/api/.env and apps/worker/.env for local runs. Values below match docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=info

API_PORT=3100
# Number of proxies in front of the API. 0 locally; 1 behind a single load balancer.
TRUST_PROXY_HOPS=0
APP_URL=http://localhost:3101
WEB_ORIGIN=http://localhost:3101

DB_HOST=localhost
DB_PORT=5460
DB_NAME=ai_staff
# Set to true for managed databases that require TLS (Neon, Render). Leave false for local Postgres.
DB_SSL=false
# The API and worker connect as the app role (row-level security applies).
DB_APP_USER=ai_staff_app
DB_APP_PASSWORD=ai_staff_app_password
# Used only by the migration command.
DB_ADMIN_USER=ai_staff_admin
DB_ADMIN_PASSWORD=ai_staff_admin_password

REDIS_URL=redis://localhost:6390
# Only needed when this app shares a Redis instance with another: namespaces its queue keys. Default is "bull".
# BULL_PREFIX=ai-staff

# At least 32 random bytes, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated keyring "kid:64-hex-chars". The active key encrypts; all listed keys decrypt.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KID=

# How platform emails (verification codes, password resets, invitations) are sent: "smtp" or "resend".
EMAIL_PROVIDER=smtp
# smtp: any SMTP server. Mailpit locally: http://localhost:8030 shows sent mail. Required when EMAIL_PROVIDER=smtp.
SMTP_URL=smtp://localhost:1030
# resend: an API key from resend.com. Required when EMAIL_PROVIDER=resend. Works on hosts that block SMTP ports.
RESEND_API_KEY=
# The sender for either provider. With Resend, the domain must be verified in your Resend account.
MAIL_FROM="AI Staff <no-reply@localhost>"
