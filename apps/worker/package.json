{
  "name": "@ai-staff/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --watch-path=dist --enable-source-maps dist/main.js",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-staff/config": "workspace:*",
    "@ai-staff/core": "workspace:*",
    "@ai-staff/db": "workspace:*",
    "@ai-staff/llm": "workspace:*",
    "@ai-staff/mail": "workspace:*",
    "@ai-staff/role-sales": "workspace:*",
    "@ai-staff/roles": "workspace:*",
    "@ai-staff/social": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.0",
    "@nestjs/core": "^12.3.0",
    "bullmq": "^6.5.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.0",
    "@swc/core": "^1.16.0",
    "@types/node": "^24.0.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.0.0"
  }
}
